# Claude Code local files — ignored EXCEPT the version-controlled workflow tooling:
# this project's own /xtty: command(s), xtty-* skill(s), and xtty-* agent(s), PLUS the
# openspec-generated /opsx: command(s) and openspec-* skill(s) (tracked + CLI-version-
# pinned via their `generatedBy` stamp — see AGENTS.md "Don't track local tooling").
# Only machine-local settings/locks (settings.local.json, *.lock) stay out of git.
# (Re-include level by level — git can't un-ignore a child of an ignored directory.)
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/xtty/
!.claude/commands/opsx/
!.claude/skills/
.claude/skills/*
!.claude/skills/xtty-*/
!.claude/skills/openspec-*/
!.claude/agents/
.claude/agents/*
!.claude/agents/xtty-*

# Generated Xcode project (produced from project.yml via `xcodegen generate`)
xtty.xcodeproj/

# Swift Package Manager build artifacts
.build/
XttyCore/.build/
.swiftpm/
XttyCore/.swiftpm/

# xcodebuild DerivedData — the Makefile builds into ./build (-derivedDataPath build)
/build/

# CI-failure investigation evidence (xtty-ci-investigator): downloaded .xcresult
# bundles + notes per run. Disposable and regenerable (re-downloadable from GitHub).
# Its own dedicated dir — build/ is reserved for Xcode output, not unrelated artifacts.
/ci-investigations/

# SwiftTerm patched checkout — gitignored build infra, reconstituted by
# scripts/bootstrap-swiftterm.sh from patches/swiftterm/UPSTREAM_CONFIG.sh.
# (Playwright-style: track the patch + pin + script, not the upstream tree.)
external/SwiftTerm/

# macOS
.DS_Store
