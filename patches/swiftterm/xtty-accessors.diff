diff --git a/Sources/SwiftTerm/XttyAccessors.swift b/Sources/SwiftTerm/XttyAccessors.swift
new file mode 100644
index 0000000..d294c09
--- /dev/null
+++ b/Sources/SwiftTerm/XttyAccessors.swift
@@ -0,0 +1,84 @@
+// XttyAccessors.swift — the P4b-2 SwiftTerm engine addition (Phase 2).
+//
+// THIS FILE IS NOT COMPILED BY xtty. It is the committed artifact that the
+// Phase-2 light-up drops into the SwiftTerm package's `Sources/SwiftTerm/`
+// directory (via the chosen mechanism — a gitignored clone + git-apply'd patch,
+// or vendored source, or a fork; see research/03-analysis/swiftterm-fork-vs-patch-strategy.md
+// and openspec change add-spatial-blocks design D1). This accessor addition is
+// add-only — it modifies no existing SwiftTerm file, mirrors the already-public
+// `getScrollInvariantLine` idiom, and is the basis for the upstream PR that would
+// retire the local copy. (The same tracked .diff also carries a Package.swift hunk
+// that strips the Metal shader resource so the build needs no Metal toolchain —
+// see openspec change retire-metal-renderer.)
+//
+// It exposes the two read-only values P4b-2 needs but that are module-internal
+// today: the cursor's trim-invariant absolute row and the scrollback base. Once
+// this compiles inside the SwiftTerm module, swap the two seam bodies in
+// App/PaneController.swift (engineScrollRow / engineScrollbackBase) to read them.
+
+import Foundation
+
+public extension Terminal {
+    /// The cursor's **trim-invariant absolute row**: `buffer.yBase + buffer.y +
+    /// buffer.linesTop`. Unlike `getCursorLocation().y` — which is *yBase-relative*
+    /// despite its "relative to the visible part of the display" doc comment — this
+    /// stays correct regardless of scroll position and survives scrollback trim
+    /// (`scroll()` bumps `linesTop` as it trims, keeping `arrayIndex + linesTop`
+    /// fixed). Reverse-map it to a current display row with `row − scrollbackBase`.
+    /// Pinned to the normal buffer's coordinates via the live `buffer` (callers gate
+    /// capture on the alternate screen, so this is read on the normal buffer).
+    ///
+    /// Sibling to the existing public `getScrollInvariantLine(row:)`.
+    func getScrollInvariantCursorLocation() -> Position {
+        Position(col: buffer.x, row: buffer.yBase + buffer.y + buffer.linesTop)
+    }
+
+    /// The monotonic scrollback base (`buffer.linesTop`): the number of lines that
+    /// have scrolled off the top. Used to reverse-map an absolute row to the
+    /// current display row (`absoluteRow − scrollbackBase`) and — via `liveTop =
+    /// yBase + linesTop` — to detect a clear/reset (a drop in its high-water mark).
+    var scrollbackBase: Int { buffer.linesTop }
+}
+
+/// xtty (fix-scroll-wheel-mouse-reporting): the last mouse-wheel routing decision
+/// `TerminalView.scrollWheel` took, surfaced through xtty's DEBUG state dump so the
+/// routing is assertable on the custom-drawn, accessibility-opaque view. Pure
+/// observability — no product behavior depends on it. Not part of the upstream
+/// scrollWheel fix; it retires with the patch when the fix lands upstream.
+public struct XttyWheelRouting {
+    /// Which of the priority-ordered branches ran.
+    public enum Branch: String {
+        /// A wheel mouse-report was sent to the child (mouse reporting active).
+        case report
+        /// A cursor Up/Down key was sent to the child (alt screen, mouse off).
+        case cursorKey
+        /// The local scrollback viewport moved (primary screen / Shift-bypass).
+        case scrollback
+    }
+    public let branch: Branch
+    /// Scroll direction: true = up (wheel-up / Up arrow), false = down.
+    public let up: Bool
+    /// Number of reports/keys emitted (or scrollback lines moved) this gesture.
+    public let count: Int
+    /// The xterm wheel button for `.report` (64 up / 65 down), else nil.
+    public let button: Int?
+    /// For `.cursorKey`, whether the application-cursor (SS3) form was used
+    /// (DECCKM on); nil for other branches.
+    public let applicationCursor: Bool?
+    /// xtty (smooth-scroll-wheel-momentum): whether the routed event was an
+    /// inertial-coast (momentum) frame rather than a finger-driven one.
+    public let momentum: Bool
+    /// xtty (smooth-scroll-wheel-momentum): whether the routed event carried
+    /// precise (trackpad) deltas rather than discrete wheel notches.
+    public let precise: Bool
+
+    public init(branch: Branch, up: Bool, count: Int, button: Int?, applicationCursor: Bool?, momentum: Bool, precise: Bool) {
+        self.branch = branch
+        self.up = up
+        self.count = count
+        self.button = button
+        self.applicationCursor = applicationCursor
+        self.momentum = momentum
+        self.precise = precise
+    }
+}
