#!/bin/bash
# xtty-guide-gate v13  -- SENTINEL: do not remove this line (installer ownership marker)
#
# Refuses a push that GROWS the eagerly-injected agent guide past its ceiling.
# Meter: resolve CLAUDE.md in the PUSHED TREE + follow @-imports transitively; weigh total bytes.
# ❗❗ FAIL CLOSED. A gate that fails OPEN on its own bug is not a gate.
#   Measured: under `set -u`, macOS bash 3.2 errors on "${arr[@]}" for an EMPTY array
#   ("unbound variable"). That killed the meter mid-measurement and the hook still
#   `exit 0`'d — installed, armed, sentinel-stamped, and completely INERT, with its
#   own death buried in git's transfer output. Any internal error must REFUSE.
set -uo pipefail
# NB: NO `set -E` + ERR trap here. That combination LIED — the trap fired on resolve_entry's
# *expected* `return 1` inside a command substitution, printed "refusing rather than failing
# open", and then the push was ALLOWED (its `exit 1` killed only the subshell). Fail-closed is
# enforced below by the EXPLICIT is_int guards on every lane, which actually refuse.

REMOTE="${1:-origin}"                       # pre-push receives <remote-name> <remote-url>
MAIN_REF="refs/remotes/$REMOTE/main"

# --- repo-identity guard (A-2): only ever act on THIS project. -------------
# A hooks dir can be shared (global core.hooksPath). Never gate a repo that is not ours.
# ❗ Do NOT key this on HEAD alone: deleting the guide would then DISABLE the guard
#    that exists to refuse the deletion (measured — a self-disabling gate).
#    Ask instead: has this repo EVER had a guide, at the tip or at the published baseline?
# ❗ "any repository that has an agent guide" is NOT an identity — a shared/global hook would
#    gate a stranger's project with THIS project's ceiling. The installer stamps the repo it arms;
#    the hook only ever acts on a repo bearing that stamp.
[ "$(git config --get xtty.guide-gate 2>/dev/null || true)" = "true" ] || exit 0

# (the ceiling parse lives AFTER the identity guard: a typo'd XTTY_GUIDE_CEILING in a shell
#  profile must never make this gate REFUSE a stranger's repository — cross-repo harm, A-14-1.)
CEILING="${XTTY_GUIDE_CEILING:-51770}"
MAXDEPTH=4
FLOOR="${XTTY_GUIDE_FLOOR:-2000}"     # below this, a "shrink" is a VAPORIZE, not a diet
# A-C-comma (2026-07-18, Codex-caught): a git path may legally contain a comma (unlike a NUL or a
# `/`), so joining multiple dangling paths with `,` let a path such as "docs/a,b.md" mis-split back
# into two fragments that never resolve as themselves -- the real per-path deletion check silently
# missed it. A control byte no real filename plausibly contains is the standard fix for this class.
DANG_SEP=$'\x1f'                      # ASCII Unit Separator: joins/splits the dangling-path list
is_int() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
# A malformed ceiling made `[ "$bas" -gt "$CEILING" ]` error and the push ALLOW. Fail closed.
if ! is_int "$CEILING" || ! is_int "$FLOOR"; then
  echo "guide-gate: REFUSE — malformed ceiling/floor (CEILING='$CEILING' FLOOR='$FLOOR')." >&2
  exit 1
fi


# resolve_guide <tree-ish> -> "<total_bytes> <status>"
#   status: ok | root_missing | import_dangling
# A-1: "dangling" is TWO different events and they get OPPOSITE dispositions.
#   - an import that resolved at the BASELINE but not at the TIP  => a DELETION event  => caller REFUSES
#   - an import that never resolves anywhere (e.g. @~/home.md)    => un-pushable       => weigh 0 + warn

# ❗ A SYMLINK IS STORED AS A BLOB CONTAINING ITS TARGET PATH.
#   `git show <oid>:CLAUDE.md` on main's 120000 symlink returns the 9-byte string
#   "AGENTS.md" — NOT the 81 KB guide. A meter that does not check the tree MODE
#   reads 9 bytes for the entire guide and can never see growth. Follow the link.
# ❗ The meter counts BYTES, and it asks GIT for them.
#   `${#body}` counts CHARACTERS in the current locale and command substitution STRIPS
#   trailing newlines — so on a guide full of ❗✅⚠️ (this one) the meter under-reads the
#   blob it exists to bound, and a Unicode-only edit can grow the object with no growth seen.
#   `git cat-file -s <blob>` is the authoritative byte count: locale-proof, newline-exact.
resolve_entry() {  # $1=oid $2=path -> echoes "<blob-oid> <real-path>"; 1 = unresolvable
  local oid="$1" path="$2" hops=0 line mode blobid target
  while [ "$hops" -lt 8 ]; do
    line=$(git ls-tree "$oid" -- "$path" 2>/dev/null) || return 1
    [ -z "$line" ] && return 1
    mode=${line%% *}; line=${line#* }; blobid=${line%%$'\t'*}; blobid=${blobid##* }
    if [ "$mode" = "120000" ]; then                      # symlink: the BLOB IS the target path
      target=$(git cat-file blob "$blobid" 2>/dev/null) || return 1
      case "$target" in
        /*|'~'/*) return 1 ;;                            # absolute/home link: un-pushable
      esac
      case "$path" in
        */*) path="${path%/*}/$target" ;;
        *)   path="$target" ;;
      esac
      path=${path#./}
      hops=$(( hops + 1 )); continue
    fi
    # A-C-gitlink (2026-07-18, Codex-caught, final pass): mode 160000 is a GITLINK (a submodule) —
    # `$blobid` is the submodule's COMMIT SHA, not a blob. Without this guard the code below fell
    # through to `printf '%s %s' "$blobid" "$path"; return 0` as if it resolved to a normal file,
    # and the caller's `git cat-file -s "$blobid"` on a COMMIT object returns the commit's own tiny
    # serialized size, not the submodule's real (checked-out, genuinely eagerly-loaded) content.
    # A-C-tree (2026-07-18, self-caught while verifying A-C-gitlink): the SAME mistaken-identity bug
    # applies to mode 040000 (a TREE) -- an @import naming a directory-symlink with NO further path
    # segment beneath it (e.g. `@somedir` where somedir -> a real directory) resolves the symlink
    # chain down to a tree object here, and without this guard it too fell through and got weighed
    # via `git cat-file -s <tree-sha>` (the tree's own tiny size, not its real recursive content).
    # Never treat a tree's or a gitlink's SHA as a blob; the caller distinguishes "genuinely
    # unresolvable" from "an unsupported shape the meter can't measure" via
    # has_symlinked_ancestor/is_dir_symlink/is_gitlink on BOTH ancestor components and the
    # terminal path itself.
    case "$mode" in 040000|160000) return 1 ;; esac
    printf '%s %s' "$blobid" "$path"; return 0
  done
  return 1                                               # link loop
}

is_gitlink() {   # $1=oid $2=path -> success iff path is a gitlink (submodule) entry
  local oid="$1" path="$2" line
  line=$(git ls-tree "$oid" -- "$path" 2>/dev/null) || return 1
  [ "${line%% *}" = "160000" ]
}

# A-C-2 (2026-07-18, Codex- and Pass-C-caught independently, both empirically verified): git's
# tree model stores a symlink as a leaf BLOB (its content IS the target path) — `git ls-tree -r`
# can never see "through" one to whatever it points at, whether that target is a file (already
# handled: resolve_entry follows it) or a DIRECTORY (not handled anywhere before this fix).
# Claude Code documents directory symlinks as a sanctioned pattern for .claude/rules/ ("Symlinks
# are resolved and loaded normally" — code.claude.com/docs/en/memory, incl. the exact example
# `ln -s ~/shared-claude-rules .claude/rules/shared`) and real content behind one is genuinely
# injected — but was, before this fix, either silently dropped (a non-`.md`-suffixed symlink name
# failed the `*.md` filter) or treated as an ordinary "never existed" dangling import (weighed 0,
# warn-only). The meter cannot measure what is behind a symlinked directory, so both call sites
# below REFUSE outright rather than certify a byte count it cannot back up (D7: fail closed).

is_dir_symlink() {   # $1=oid $2=path -> success iff path is a (possibly CHAINED) symlink whose
                      # eventual target names a TREE or a GITLINK (both unmeasurable the same way)
  local oid="$1" path="$2" hops=0 line mode blobid target
  # A-C-2c (2026-07-18, Codex- and Pass-C-caught independently, both empirically verified): the
  # original version resolved exactly ONE hop, so a symlink pointing at ANOTHER symlink that in
  # turn points at a directory (`.claude/rules/shared -> intermediate -> external-rules/`) fell
  # through the `mode != 120000` check on the SECOND hop and returned 1 (not a directory) --
  # WORSE than the original bug: not even flagged as unresolved_symlink, totally silent. Loop like
  # resolve_entry already does (same 8-hop cap) instead of resolving exactly once.
  # A-C-symlink-gitlink (2026-07-18, Codex stop-gate-caught, final): a symlink CHAIN that
  # terminates at a GITLINK (`.claude/rules/shared.md -> ../../a-submodule`) is a THIRD unmeasurable
  # shape, distinct from both "chain ends at a directory" (already handled) and "the entry ITSELF
  # is directly a gitlink" (is_gitlink, which does not follow a symlink chain at all). Before this
  # fix the chain hit `mode=160000` here, failed the `= "040000"` test, failed the `= "120000"`
  # test too (a gitlink is neither), and fell through to `return 1` -- silently misclassified by
  # the caller as an ordinary dangling import (weigh 0, warn) rather than refused. Verified by
  # effect: the push was ALLOWED with 5000 real bytes uncounted.
  while [ "$hops" -lt 8 ]; do
    line=$(git ls-tree "$oid" -- "$path" 2>/dev/null) || return 1
    [ -z "$line" ] && return 1
    mode=${line%% *}
    case "$mode" in 040000|160000) return 0 ;; esac      # reached a directory OR a gitlink: success
    [ "$mode" = "120000" ] || return 1                    # a non-directory, non-symlink blob: not a dir
    line=${line#* }; blobid=${line%%$'\t'*}; blobid=${blobid##* }
    target=$(git cat-file blob "$blobid" 2>/dev/null) || return 1
    case "$target" in /*|'~'/*) return 1 ;; esac          # absolute/home: un-pushable, not our concern
    case "$path" in */*) path="${path%/*}/$target" ;; *) path="$target" ;; esac
    path=${path#./}
    hops=$(( hops + 1 ))
  done
  return 1                                                 # link loop / chain too deep
}

has_symlinked_ancestor() {   # $1=oid $2=path -> success iff a component BEFORE the last is a
                              # symlink OR a gitlink (both are content this meter can't measure)
  local oid="$1" path="$2" prefix="" rest seg line mode
  case "$path" in */*) : ;; *) return 1 ;; esac
  rest="${path%/*}"                                      # only the DIRECTORY prefix matters
  while [ -n "$rest" ]; do
    case "$rest" in
      */*) seg="${rest%%/*}"; rest="${rest#*/}" ;;
      *)   seg="$rest"; rest="" ;;
    esac
    prefix="${prefix:+$prefix/}$seg"
    line=$(git ls-tree "$oid" -- "$prefix" 2>/dev/null) || return 1
    [ -z "$line" ] && return 1
    mode=${line%% *}
    # A-C-gitlink: an @import traversing a GITLINK ancestor (e.g. `@submodule-dir/file.md` where
    # submodule-dir is itself a submodule) is exactly as unmeasurable as one traversing a symlinked
    # directory -- git's tree model can't address "through" a gitlink's checked-out content either.
    case "$mode" in 120000|160000) return 0 ;; esac
  done
  return 1
}

# -> "<bytes> <status> <digest> <root_gone> <dangling-paths,>"
#    status: ok | root_missing | import_dangling | unresolved_symlink
#    the dangling PATH LIST is returned so the caller can compare baseline-vs-tip PER PATH:
#    an import that DISAPPEARED is a deletion (refuse); one that was NEVER there is new-and-broken
#    (warn, weigh 0) — an aggregate flag conflates them and mis-fires both ways.
has_paths_frontmatter() {   # $1=oid $2=path
  # NB: in awk, `exit 0` inside a rule STILL RUNS THE END BLOCK — an `END { exit 1 }` there
  # silently overrides it. Set a flag; exit exactly once, in END.
  # A-C-3 (2026-07-18, Codex-caught): `ok` must require the CLOSING `---`, not just a `paths:`
  # line. The old rule set `ok=1` the instant it saw `paths:`, so an OPENED-but-never-CLOSED
  # frontmatter block (a malformed rule: `---`, `paths: …`, then arbitrarily large body, no second
  # `---`) was falsely exempted forever — an unmetered fake-diet lane inside the metering code
  # itself, worse than the `^paths:`-anywhere bug arm 39 already guards. Only the CLOSING
  # delimiter may set `ok`, and only if a `paths:` line was already seen.
  git cat-file blob "$1:$2" 2>/dev/null | awk '
    NR == 1 { if ($0 != "---") done = 1; next }        # no opening `---` => NOT frontmatter
    done { next }
    /^paths:/ { saw_paths = 1; next }
    /^---[[:space:]]*$/ { if (saw_paths) ok = 1; done = 1; next }
    END { exit (ok ? 0 : 1) }'
}

resolve_guide() {
  local oid="$1" total=0 hop=0 status=ok dangling="" closure="" root_gone=no
  local -a queue=("CLAUDE.md") next=() seen=()
  local ent blobid real imp p sz body already sv

  # every EAGERLY-INJECTED root, not just CLAUDE.md.
  local r
  # NUL-delimited: a rule filename may contain spaces (`$(…)` word-splitting dropped them).
  while IFS= read -r -d '' r; do
    [ -z "$r" ] && continue
    # A-C-2e (2026-07-18, Codex stop-gate-caught): the directory-symlink check MUST run before the
    # `*.md` filter, not only in its `*)` (non-.md) branch. A symlink's OWN NAME can end in `.md`
    # (e.g. `.claude/rules/shared.md -> ../../external-rules/`) -- a plausible, even likely name
    # choice -- and such an entry sailed straight past is_dir_symlink into `queue`, where
    # resolve_entry follows the symlink to a TREE object, mistakes it for a file blob (mode check
    # only guards against 120000, not 040000), and `git cat-file -s` on a tree returns the tree
    # object's OWN small serialized size, not its real recursive content -- a silent, near-total
    # under-count with the push ALLOWED. Check every entry, regardless of suffix.
    # A-C-gitlink: a gitlink (submodule, mode 160000) is checked the SAME as a directory symlink —
    # git ls-tree reports it as a leaf, its checked-out content is genuinely eagerly-loaded by the
    # real product, and this meter has no way to weigh what's inside it either. Verified by effect:
    # a submodule at `.claude/rules/shared` let 5000 real bytes through with the push ALLOWED.
    if is_dir_symlink "$oid" "$r" || is_gitlink "$oid" "$r"; then
      status=unresolved_symlink
      continue
    fi
    case "$r" in
      *.md) ;;
      *) continue ;;
    esac
    # A rule is READ-TRIGGERED (not eager) ONLY if it has real YAML frontmatter carrying `paths`.
    # DOCS: the frontmatter is delimited by `---` lines. A grep for `^paths:` anywhere in the head
    # both (a) misses the delimiters and (b) falsely exempts a rule whose BODY happens to start a
    # line with "paths:" — an unmetered fake-diet lane in the metering code itself.
    if [ "${r#.claude/rules/}" != "$r" ] && has_paths_frontmatter "$oid" "$r"; then continue; fi
    queue+=("$r")
  done < <(
    git ls-tree -r -z --name-only "$oid" -- .claude/rules 2>/dev/null || true
    for r in .claude/CLAUDE.md CLAUDE.local.md; do
      git ls-tree "$oid" -- "$r" 2>/dev/null | grep -q . && printf '%s\0' "$r"
    done
  )
  # the root CLAUDE.md is just ONE eager root. Keep it only if it actually resolves;
  # "no guide" means the eager-root SET is empty — not merely that the root is absent.
  if ! resolve_entry "$oid" CLAUDE.md >/dev/null 2>&1; then
    queue=(${queue[@]+"${queue[@]}"})
    local -a keep=()
    for p in ${queue[@]+"${queue[@]}"}; do [ "$p" = "CLAUDE.md" ] || keep+=("$p"); done
    queue=(${keep[@]+"${keep[@]}"})
    root_gone=yes
  fi
  # A-C-2d (2026-07-18, Codex-caught): an empty queue used to hardcode `root_missing`
  # UNCONDITIONALLY, discarding an already-detected `unresolved_symlink` from the .claude/rules
  # scan above (e.g. a directory symlink as the ONLY thing under .claude/rules, with no other
  # eager root) -- the caller's "no baseline"/"unfetched baseline" lanes check `root_missing`
  # FIRST and allow, so real content behind an undetected symlink was waved through as "no guide
  # at all," worse than an ordinary refuse. Preserve whatever `status` already holds.
  if [ ${#queue[@]} -eq 0 ]; then printf '0 %s - yes none' "$status"; return; fi

  # `hop` counts IMPORT HOPS. The root is hop 0 and must not consume one, or a
  # declared "max depth 4" only ever follows 3 (measured off-by-one).
  while [ ${#queue[@]} -gt 0 ] && [ "$hop" -le "$MAXDEPTH" ]; do
    next=()
    for p in "${queue[@]}"; do
      # A-C-seen (2026-07-18, Pass-C-caught, independent of round 1's brief, empirically verified):
      # a space-wrapped SUBSTRING check (`case " $seen " in *" $p "*)`) false-positives whenever one
      # already-queued path's TAIL exactly equals a later, genuinely DISTINCT path bounded by
      # spaces (e.g. queued ".claude/rules/AAA bar.md" makes a later, unrelated "bar.md" register
      # as already-seen) — the later path is silently skipped, its growth never added to `total`.
      # A pre-existing bug (predates this session's fixes; confirmed unchanged by round C's diff),
      # invisible to substring-matching for 15+ prior review rounds and the whole fixture suite.
      # Exact ARRAY membership, not string containment, closes it.
      already=no
      for sv in ${seen[@]+"${seen[@]}"}; do [ "$sv" = "$p" ] && { already=yes; break; }; done
      [ "$already" = yes ] && continue
      seen+=("$p")
      if ! ent=$(resolve_entry "$oid" "$p"); then
        case "$p" in
          '~'/*|/*) echo "guide-gate:   note — un-pushable import weighed 0: $p" >&2 ;;
          *)
            # A-C-terminal (2026-07-18, self-caught while verifying A-C-gitlink): an ancestor-only
            # check misses the import naming an unsupported shape DIRECTLY, with no path separator
            # at all (e.g. `@sublink` where sublink is itself a gitlink, or `@somedir` where
            # somedir is a symlink to a directory) -- has_symlinked_ancestor returns false
            # immediately for a single-segment path (nothing to check), and resolve_entry's own
            # failure alone can't distinguish "unsupported shape" from "genuinely never existed."
            # Check both: an ancestor component, OR the terminal path itself.
            if has_symlinked_ancestor "$oid" "$p" || is_dir_symlink "$oid" "$p" || is_gitlink "$oid" "$p"; then
              # A-C-2b: git cannot address a path THROUGH a symlinked directory (confirmed
              # empirically — `git ls-tree <oid> -- linkdir/file.md` returns nothing even when
              # the checked-out filesystem resolves it fine). resolve_entry's plain failure here
              # is indistinguishable from "never existed," but the real product injects whatever
              # is actually there — do not silently treat it as an ordinary dangling import.
              status=unresolved_symlink
            else
              [ "$status" = unresolved_symlink ] || status=import_dangling
              dangling="$dangling$p$DANG_SEP"
            fi
            ;;
        esac
        continue
      fi
      blobid=${ent%% *}; real=${ent#* }
      seen+=("$real")                               # don't double-count a link and its target
      sz=$(git cat-file -s "$blobid" 2>/dev/null) || { [ "$status" = unresolved_symlink ] || status=import_dangling; dangling="$dangling$p$DANG_SEP"; continue; }
      total=$(( total + sz ))
      closure="$closure$real:$blobid\n"          # the CONTENT of the whole closure, not 2 paths
      body=$(git cat-file blob "$blobid" 2>/dev/null) || true
      # imports: any @path token anywhere in a line; skip fenced code; resolve relative to THIS file.
      while IFS= read -r imp; do
        [ -z "$imp" ] && continue
        case "$imp" in
          '~'/*|/*) next+=("$imp"); continue ;;          # home/absolute: un-pushable, weighed 0 later
        esac
        case "$real" in
          */*) next+=("${real%/*}/$imp") ;;              # relative to the CONTAINING file
          *)   next+=("$imp") ;;
        esac
      done < <(printf '%s\n' "$body" | awk '
          /^[[:space:]]*```/ { fence = !fence; next }
          fence { next }
          {
            line = $0
            gsub(/`[^`]*`/, " ", line)                   # drop inline code spans
            n = split(line, toks, /[[:space:]]+/)
            for (i = 1; i <= n; i++) {
              t = toks[i]
              if (substr(t, 1, 1) == "@") {
                sub(/^@/, "", t)
                gsub(/[),.;:!?]+$/, "", t)               # trailing punctuation is prose, not path
                if (t != "") print t
              }
            }
          }')
    done
    # bash 3.2 (macOS): "${arr[@]}" on an EMPTY array is an UNBOUND-VARIABLE error under set -u.
    # That error killed the meter mid-measurement and the hook still exited 0 => a gate that was
    # installed, armed, and completely INERT. Guard the expansion.
    queue=(${next[@]+"${next[@]}"})
    hop=$(( hop + 1 ))
  done
  # A-15-2/A-15-2b (2026-07-18, Codex-caught, two rounds): root deletion must be reported even
  # when SOME OTHER eager root's import is dangling -- on EITHER side. round 1 tried promoting
  # the aggregate `status` to root_deleted, but the caller also required the BASELINE's
  # aggregate status to be "ok", so a PRE-EXISTING published dangling import elsewhere in the
  # closure masked a real deletion just the same (round 1's fix only helped when the dangling
  # import was newly introduced in the SAME commit as the deletion). The durable fix decouples
  # this from the aggregate status entirely: expose root-gone as its OWN dedicated field so the
  # caller can check "did the ROOT resolve" independently of dangling-import status on either
  # side. root_missing (queue empty) also implies no root -- report "yes" there too.
  # A-C-1 (2026-07-18, Codex-caught): `dangling` is the ONE field that can legitimately contain
  # embedded WHITESPACE (a rule filename may contain spaces — arm 40) — `read`'s word-splitting
  # then shifts every field AFTER it, corrupting `root_gone` into a two-word non-yes/no string and
  # silently defeating the root-deletion check. `read`'s LAST named variable absorbs the entire
  # remainder of the line, embedded spaces and all — so `dangling` must be LAST, never a middle
  # field. (`total`/`status`/`digest`/`root_gone` are all space-proof: an enum, a hex hash, yes/no.)
  # ⚠️ This closes the SPACE case (the realistic one — arm 40 shows honest rule filenames use it).
  # A literal embedded NEWLINE in a path is NOT closed by field ORDER alone (round-2 soundness
  # pass, confidence 0.85) -- the outer printf/read handoff is itself line-based, so a raw newline
  # anywhere in `dangling` truncates what `read` captures. Accepted as an R3 adversarial-
  # construction residual, not fixed: an honest session does not create newline-embedded
  # filenames (design.md Risks).
  printf '%s %s %s %s %s' "$total" "$status" "$(printf '%s' "$closure" | git hash-object --stdin)" "$root_gone" "${dangling:-none}"
}

canonical=$(git rev-parse -q --verify "$MAIN_REF" 2>/dev/null || true)
canon_bytes=""
canon_digest=""
if [ -n "$canonical" ]; then read -r canon_bytes _ canon_digest _ _ <<<"$(resolve_guide "$canonical")"; fi

status=0
zero='0000000000000000000000000000000000000000'

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_ref:-}" ] && continue
  [ "$local_oid" = "$zero" ] && continue                    # deletion push => allow

  read -r cur cur_status cur_digest cur_root_gone cur_dangling <<<"$(resolve_guide "$local_oid")"

  # --- THE LADDER (order matters) -----------------------------------------
  base=""
  if [ "$remote_oid" = "$zero" ]; then
    # gpt#2: FIRST PUSH is detected BEFORE any tracking ref (a stale tracking ref
    # for a deleted-then-recreated branch would otherwise become the baseline).
    base=$(git merge-base "$local_oid" "$MAIN_REF" 2>/dev/null || true)
    # A-5/gpt#1: NO rung-4 fallback (borrowing main's guide as an orphan ref's baseline
    # made the deletion rule fire on a ref that never had a guide).
    if [ -z "$base" ]; then
      # ...but "no baseline => allow" is a BLANKET HOLE: with no origin/main (a fresh
      # clone, or main's own first push) it waves EVERYTHING through. Split it:
      if [ "$cur_status" = root_missing ]; then
        echo "guide-gate: $local_ref — unrelated history, no guide => allow" >&2; continue
      fi
      # A-C-2c: an unresolved-symlink guide's byte count is INCOMPLETE (whatever is behind the
      # symlink is not in it) — never let it pass a ceiling check that only looks trustworthy.
      if [ "$cur_status" = unresolved_symlink ]; then
        echo "guide-gate: REFUSE $local_ref — no baseline, and an unsupported SYMLINKED DIRECTORY" >&2
        echo "guide-gate:   is reachable from the eager guide (the meter cannot measure it)." >&2
        status=1; continue
      fi
      if ! is_int "${cur:-}"; then
        echo "guide-gate: REFUSE $local_ref — no baseline and the meter failed (fail-closed)." >&2
        status=1; continue
      fi
      if [ "$cur" -gt "$CEILING" ]; then
        echo "guide-gate: REFUSE $local_ref — no baseline, and guide ${cur} B > ceiling ${CEILING}" >&2
        status=1; continue
      fi
      echo "guide-gate: $local_ref — no baseline, guide under ceiling => allow" >&2; continue
    fi
  elif git cat-file -e "$remote_oid" 2>/dev/null; then
    base="$remote_oid"                                      # advertised and resolves locally
  else
    # A-15-1 (2026-07-18, Codex-caught): the remote advertised an OID we do not have locally
    # (a second clone/pusher updated this ref; we never fetched). A local tracking ref for this
    # branch may still resolve, but by construction it can only be STALE relative to the actual
    # (unfetched) remote tip -- comparing against it can silently permit real regrowth. Measured:
    # remote diets 1500->600 B; a clone that never fetched the diet still believes the remote is
    # 1500 and force-pushes 1400 B -- trusting the stale tracking ref as baseline compares 1400
    # against 1500 and ALLOWS a real over-ceiling regrowth against the true 600 B remote.
    trust_stale_tracking_ref=no   # NEVER yes -- see A-15-1 above; "allow" here measured NOTHING
    stale_ref=$(git rev-parse -q --verify "refs/remotes/$REMOTE/${remote_ref#refs/heads/}" 2>/dev/null || true)
    if [ "$trust_stale_tracking_ref" = yes ] && [ -n "$stale_ref" ]; then
      base="$stale_ref"
    elif [ "$cur_status" = root_missing ]; then
      echo "guide-gate: $local_ref — unfetched baseline, no guide => allow" >&2; continue
    elif [ "$cur_status" = unresolved_symlink ]; then
      echo "guide-gate: REFUSE $local_ref — unfetched baseline, and an unsupported SYMLINKED" >&2
      echo "guide-gate:   DIRECTORY is reachable from the eager guide (cannot be measured)." >&2
      status=1; continue
    elif ! is_int "${cur:-}"; then
      echo "guide-gate: REFUSE $local_ref — unfetched baseline and the meter failed (fail-closed)." >&2
      status=1; continue
    elif [ "$cur" -gt "$CEILING" ]; then
      echo "guide-gate: REFUSE $local_ref — unfetched baseline, and guide ${cur} B > ceiling ${CEILING}" >&2
      status=1; continue
    else
      echo "guide-gate: $local_ref — unfetched baseline, guide under ceiling => allow" >&2; continue
    fi
  fi

  read -r bas bas_status bas_digest bas_root_gone bas_dangling <<<"$(resolve_guide "$base")"
  if ! is_int "${cur:-}" || ! is_int "${bas:-}"; then
    echo "guide-gate: REFUSE $local_ref — the meter failed to produce a measurement (fail-closed)." >&2
    status=1; continue
  fi

  # --- unresolved symlink shapes (A-C-2/A-C-2b) ---------------------------
  # The meter cannot see behind a DIRECTORY-mode symlink (.claude/rules/ or an @import through an
  # intermediate symlinked directory) — real content the product injects is invisible to it either
  # way, on either side. Refuse unconditionally rather than certify a byte count it cannot back up.
  if [ "$cur_status" = unresolved_symlink ] || [ "$bas_status" = unresolved_symlink ]; then
    echo "guide-gate: REFUSE $local_ref — an unsupported SYMLINKED DIRECTORY is reachable from the" >&2
    echo "guide-gate:   eager guide (.claude/rules/ or an @import) — the meter cannot measure what" >&2
    echo "guide-gate:   is behind it. Remove the symlink (or use --no-verify if intentional)." >&2
    status=1; continue
  fi

  # --- guide DELETED (any ref) --------------------------------------------
  # A-1: the ROOT vanishing and an IMPORT vanishing are the SAME accident.
  # A-15-2b: use the DEDICATED root_gone fields, not the aggregate status -- the aggregate
  # conflates "root gone" with "some unrelated import is dangling" on EITHER side (baseline or
  # tip), and requiring bas_status=ok masked a real deletion when the baseline ITSELF already
  # had a published, pre-existing dangling import elsewhere in the closure.
  if [ "$bas_root_gone" = no ] && [ "$cur_root_gone" = yes ]; then
    echo "guide-gate: REFUSE $local_ref — the guide ROOT (CLAUDE.md) was DELETED (baseline had one)" >&2
    status=1; continue
  fi
  # ❗ PER-PATH, not aggregate. An import that RESOLVED at the baseline and DANGLES at the tip is a
  #    DELETION (the vaporize lane: the root survives, so the meter reads a "shrink"). An import that
  #    was ALREADY broken, or is newly-added-and-broken, is not a deletion — warn, weigh 0, allow.
  if [ "$cur_status" = import_dangling ]; then
    vaporized=""
    IFS="$DANG_SEP" read -ra _dangs <<<"${cur_dangling%$DANG_SEP}"
    for _d in ${_dangs[@]+"${_dangs[@]}"}; do
      [ -z "$_d" ] || [ "$_d" = none ] && continue
      # RESOLVABLE at the baseline (not merely present): a dangling symlink import EXISTS in the
      # tree yet resolves to nothing, and treating it as "was fine, now broken" latches a false refusal.
      if resolve_entry "$base" "$_d" >/dev/null 2>&1; then vaporized="$vaporized $_d"; fi
    done
    if [ -n "$vaporized" ]; then
      echo "guide-gate: REFUSE $local_ref — guide IMPORT(S) resolved at the baseline and DANGLE at the tip:$vaporized" >&2
      echo "guide-gate:   (the root survives, so the meter reads a 'shrink' — this is the vaporize lane)" >&2
      status=1; continue
    fi
    disp="${cur_dangling%$DANG_SEP}"; disp="${disp//$DANG_SEP/, }"
    echo "guide-gate: warn $local_ref — unresolvable import(s) weighed 0: $disp" >&2
  fi
  # Skip ONLY when neither side has a guide at all. `import_dangling` still has a MEASURABLE
  # guide — treating it as "no guide" latched the gate OPEN once a dangling import was published.
  if [ "$bas_status" = root_missing ] && [ "$cur_status" = root_missing ]; then continue; fi

  # --- THE VAPORIZE FLOOR (D-1) -------------------------------------------
  # A symlink replaced by a 9-byte regular file containing the literal text "AGENTS.md" is
  # NOT an import — the injected guide really is 9 bytes, and the meter honestly reports a
  # "shrink". Every path-based deletion rule missed it. Judge the OUTCOME, not the mechanism:
  # a guide that had real content and now has almost none was vaporized, however it happened.
  if [ "$bas" -ge "$FLOOR" ] && [ "$cur" -lt "$FLOOR" ]; then
    echo "guide-gate: REFUSE $local_ref — the guide COLLAPSED ${bas} -> ${cur} B (floor ${FLOOR})." >&2
    echo "guide-gate:   A diet shrinks the guide; it does not vaporize it. If this is intentional," >&2
    echo "guide-gate:   raise XTTY_GUIDE_FLOOR for this push and say so in the commit." >&2
    status=1; continue
  fi

  # --- rung 0 (A-4): already-published canonical guide ---------------------
  # Mirroring origin/main's CURRENT guide introduces no bytes the remote lacks
  # (a fast-forward branch sync / `main:<branch>` repoint transmits zero new objects).
  # A-15-1b (2026-07-18, Codex-caught, round 2): `canonical` is resolved from OUR OWN local
  # tracking ref for origin/main (line ~198) -- exactly the kind of STALE signal A-15-1 already
  # refused to trust as a baseline elsewhere in this hook. A clone that hasn't fetched a diet
  # landed on the real remote main can still have a local_oid whose CONTENT digest matches that
  # stale fat canonical (e.g. an old feature branch never rebased past the diet) -- letting a
  # content-only digest match authorize an over-ceiling push regardless of commit identity would
  # reopen exactly the hole A-15-1 closed, just via rung 0 instead of the unfetched-baseline lane.
  # Require EITHER a proven zero-transfer repoint (local_oid IS canonical, the exact same commit
  # object -- true for a real `main:<branch>` mirror, e.g. arm 14) OR that the result is itself
  # safely under the ceiling regardless of staleness (trivially safe either way). A content-only
  # match on a DIFFERENT, over-ceiling commit no longer gets the fast path -- it falls through to
  # the ordinary comparator below, which judges it on its own (non-stale) baseline correctly.
  if [ -n "${canon_digest:-}" ] && [ "$cur_digest" = "$canon_digest" ] && [ "$cur" -ne "$bas" ] \
     && { [ "$local_oid" = "${canonical:-}" ] || [ "$cur" -le "$CEILING" ]; }; then
    echo "guide-gate: $local_ref — guide closure IDENTICAL to $REMOTE/main's published guide => allow" >&2
    continue
  fi

  # --- the comparator ------------------------------------------------------
  if [ "$bas" -gt "$CEILING" ]; then
    if [ "$cur" -gt "$bas" ]; then
      echo "guide-gate: REFUSE $local_ref — guide GREW ${bas} -> ${cur} B (over ceiling; baseline ${base:0:9})" >&2
      status=1
    fi
  else
    if [ "$cur" -gt "$CEILING" ]; then
      echo "guide-gate: REFUSE $local_ref — guide ${cur} B > ceiling ${CEILING} (baseline ${base:0:9} was ${bas})" >&2
      status=1
    fi
  fi
done

if [ "$status" -ne 0 ]; then
  cat >&2 <<'MSG'
guide-gate: ---------------------------------------------------------------
guide-gate: RECOVERY — read the REFUSE line above first; it names the ref and the reason.
guide-gate: If it printed a baseline (a growth-over-ceiling refusal), ON THE REFUSED REF
guide-gate:   (check it out first):
guide-gate:     git restore --source=<that baseline OID> --staged --worktree -- AGENTS.md
guide-gate:     # (or whichever tracked eager root / import you grew), re-apply your
guide-gate:     # MANDATED bounded tracker edit, then: git commit --amend --no-edit
guide-gate: If NO baseline was printed (a first-push / unfetched-baseline refusal), there is
guide-gate:   nothing to restore FROM — just shrink the guide edit in this commit instead.
guide-gate: Either way: park the finding on its named tracked surface (AGENTS.md "Keep progress current").
guide-gate: ---------------------------------------------------------------
MSG
fi
exit "$status"
